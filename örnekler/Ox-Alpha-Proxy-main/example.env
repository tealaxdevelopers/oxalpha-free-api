# ── Ox Alpha Proxy — environment template ──
# Copy to .env:  cp .env.example .env   (Windows: copy .env.example .env)
# Or run via:    node --env-file=.env server.js

# Server — LAN off by default (127.0.0.1 = this PC only). Set HOST=0.0.0.0 to enable LAN.
PORT=3000
HOST=127.0.0.1
TIMEOUT=300000
HEADED=0
PROFILE=./profile
NO_BROWSER=0

# Files
CHATS_FILE=./chats.json
SETTINGS_FILE=./settings.json
CLIENTS_FILE=./clients.json
USERS_FILE=./users.json
SELECTORS_FILE=./selectors.json
MEMORY_FILE=./memory.json
SANDBOX_DIR=./sandbox

# Auth (optional — when set, /api/* and /v1/* require auth)
AUTH_TOKEN=
ALLOW_SIGNUP=1
ENCRYPT_KEY=

# Context / memory (unlimited memory via auto-compaction)
CONTEXT_BUDGET=320000
MAX_PROMPT=500000

# Upstream Ox Alpha
OX_ALPHA_URL=https://oxalpha.com
OX_ALPHA_CHAT_URL=https://oxalpha.com/chat
OX_ALPHA_API_URL=https://oxalpha.com/api/chat
MODEL_ID=z-ai/glm-5.3-flash
MODEL_SLUG=ox-alpha
MODEL_NAME=Ox Alpha
MODEL_COLOR=#6e56cf

# Sandbox / tools (per-user, memory-limited)
SANDBOX_ENABLED=1
SANDBOX_MEMORY_MB=512
SANDBOX_TIMEOUT_MS=30000
SANDBOX_ALLOW_NETWORK=0
TOOLS_ENABLED=1

# CORS (for IDEs/CLIs/browser apps that need it)
CORS_ALLOW=0
CORS_ORIGINS=

# Updates
UPDATE_CHECK=1
TTS_MAX_CHARS=20000
