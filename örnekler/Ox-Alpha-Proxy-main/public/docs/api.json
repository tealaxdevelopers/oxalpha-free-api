{
  "openapi": "3.1.0",
  "info": {
    "title": "Ox Alpha Proxy",
    "description": "OpenAI-compatible API with tool calling, streaming, voice, sandbox, memory — local by default",
    "version": "0.5.0",
    "license": { "name": "MIT" }
  },
  "servers": [
    { "url": "http://127.0.0.1:3000", "description": "Local (default)" }
  ],
  "paths": {
    "/v1/chat/completions": {
      "post": {
        "operationId": "createChatCompletion",
        "summary": "OpenAI-compatible chat completion",
        "description": "Full OpenAI-compatible endpoint with streaming, tool calling, image understanding, and per-user persistent chat.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "model": { "type": "string", "default": "ox-alpha", "description": "Any string — maps to Ox Alpha" },
                  "messages": { "type": "array", "items": { "$ref": "#/components/schemas/Message" } },
                  "stream": { "type": "boolean", "default": false },
                  "tools": { "type": "array", "items": { "$ref": "#/components/schemas/Tool" } },
                  "tool_choice": { "type": ["string", "object"] },
                  "response_format": { "type": "object", "properties": { "type": { "type": "string" } } },
                  "user": { "type": "string", "description": "Session ID for persistent chat" },
                  "max_tokens": { "type": "integer" }
                },
                "required": ["messages"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Chat completion (non-streaming)", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ChatCompletion" } } } },
          "200": { "description": "SSE stream (streaming)", "content": { "text/event-stream": { "schema": { "type": "string" } } } }
        }
      }
    },
    "/v1/models": {
      "get": {
        "operationId": "listModels",
        "summary": "List available models",
        "responses": {
          "200": { "description": "Model list", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ModelList" } } } }
        }
      }
    },
    "/v1/messages": {
      "post": {
        "operationId": "createMessage",
        "summary": "Anthropic-compatible message (Claude Code)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "model": { "type": "string" },
                  "messages": { "type": "array", "items": { "$ref": "#/components/schemas/Message" } },
                  "system": { "type": "string" },
                  "max_tokens": { "type": "integer" },
                  "stream": { "type": "boolean" }
                },
                "required": ["messages"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Anthropic message format", "content": { "application/json": {} } }
        }
      }
    },
    "/v1/responses": {
      "post": {
        "operationId": "createResponse",
        "summary": "Responses API (Cursor, Codex)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "model": { "type": "string" },
                  "input": { "type": ["string", "array"] },
                  "stream": { "type": "boolean" }
                },
                "required": ["input"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Response object" }
        }
      }
    },
    "/api/chat": {
      "post": {
        "operationId": "webChat",
        "summary": "Web UI chat (SSE)",
        "description": "Server-Sent Events stream used by the web chat interface.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "message": { "type": "string" },
                  "chatId": { "type": "string" },
                  "images": { "type": "array", "items": { "type": "object", "properties": { "name": { "type": "string" }, "dataUrl": { "type": "string" } } } }
                },
                "required": ["message"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "SSE event stream" }
        }
      }
    },
    "/api/chats": {
      "get": {
        "operationId": "listChats",
        "summary": "List all chats",
        "responses": {
          "200": { "description": "Chat list", "content": { "application/json": { "schema": { "type": "object", "properties": { "chats": { "type": "array" }, "activeChatId": { "type": "string" } } } } } }
        }
      }
    },
    "/api/new-chat": {
      "post": {
        "operationId": "createChat",
        "summary": "Create a new chat",
        "responses": {
          "200": { "description": "New chat ID", "content": { "application/json": { "schema": { "type": "object", "properties": { "id": { "type": "string" } } } } } }
        }
      }
    },
    "/api/chat-rename": {
      "post": {
        "operationId": "renameChat",
        "summary": "Rename a chat",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "properties": { "chatId": { "type": "string" }, "title": { "type": "string" } }, "required": ["chatId", "title"] } } }
        },
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/chat-delete": {
      "post": {
        "operationId": "deleteChat",
        "summary": "Delete a chat",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "properties": { "chatId": { "type": "string" } }, "required": ["chatId"] } } }
        },
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/history": {
      "get": {
        "operationId": "getHistory",
        "summary": "Get chat history",
        "parameters": [
          { "name": "chatId", "in": "query", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Messages", "content": { "application/json": { "schema": { "type": "object", "properties": { "messages": { "type": "array" } } } } } }
        }
      }
    },
    "/api/export": {
      "get": {
        "operationId": "exportChat",
        "summary": "Export chat transcript",
        "parameters": [
          { "name": "chatId", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "format", "in": "query", "schema": { "type": "string", "enum": ["md", "json"] } }
        ],
        "responses": { "200": { "description": "File download" } }
      }
    },
    "/api/status": {
      "get": {
        "operationId": "getStatus",
        "summary": "Server status",
        "responses": {
          "200": { "description": "Status", "content": { "application/json": { "schema": { "type": "object", "properties": { "ready": { "type": "boolean" }, "busy": { "type": "boolean" }, "queueLength": { "type": "integer" }, "lanIps": { "type": "array", "items": { "type": "string" } }, "port": { "type": "integer" }, "version": { "type": "string" } } } } } }
        }
      }
    },
    "/api/tts": {
      "get": {
        "operationId": "textToSpeech",
        "summary": "Text-to-speech (Edge TTS)",
        "parameters": [
          { "name": "text", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "voice", "in": "query", "schema": { "type": "string", "default": "en-US-AriaNeural" } }
        ],
        "responses": { "200": { "description": "MP3 audio stream", "content": { "audio/mpeg": {} } } }
      }
    },
    "/api/settings": {
      "get": {
        "operationId": "getSettings",
        "summary": "Get settings",
        "responses": { "200": { "description": "Settings", "content": { "application/json": { "schema": { "type": "object", "properties": { "systemPrompt": { "type": "string" } } } } } } }
      },
      "post": {
        "operationId": "updateSettings",
        "summary": "Update settings",
        "requestBody": {
          "content": { "application/json": { "schema": { "type": "object", "properties": { "systemPrompt": { "type": "string" } } } } }
        },
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/signup": {
      "post": {
        "operationId": "signup",
        "summary": "Create account",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "properties": { "username": { "type": "string" }, "password": { "type": "string" } }, "required": ["username", "password"] } } }
        },
        "responses": { "200": { "description": "Credentials", "content": { "application/json": { "schema": { "type": "object", "properties": { "clientId": { "type": "string" }, "clientToken": { "type": "string" } } } } } } }
      }
    },
    "/api/login": {
      "post": {
        "operationId": "login",
        "summary": "Login",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "properties": { "username": { "type": "string" }, "password": { "type": "string" } }, "required": ["username", "password"] } } }
        },
        "responses": { "200": { "description": "Credentials" } }
      }
    },
    "/health": {
      "get": {
        "operationId": "healthCheck",
        "summary": "Health check",
        "responses": { "200": { "description": "OK", "content": { "application/json": { "schema": { "type": "object", "properties": { "ok": { "type": "boolean" } } } } } } }
      }
    }
  },
  "components": {
    "schemas": {
      "Message": {
        "type": "object",
        "properties": {
          "role": { "type": "string", "enum": ["system", "user", "assistant", "tool"] },
          "content": { "type": ["string", "array"] },
          "tool_calls": { "type": "array" },
          "tool_call_id": { "type": "string" }
        },
        "required": ["role"]
      },
      "Tool": {
        "type": "object",
        "properties": {
          "type": { "type": "string", "enum": ["function"] },
          "function": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "description": { "type": "string" },
              "parameters": { "type": "object" }
            }
          }
        }
      },
      "ChatCompletion": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "object": { "type": "string" },
          "choices": { "type": "array", "items": { "type": "object", "properties": { "message": { "$ref": "#/components/schemas/Message" }, "finish_reason": { "type": "string" } } } },
          "usage": { "type": "object", "properties": { "prompt_tokens": { "type": "integer" }, "completion_tokens": { "type": "integer" }, "total_tokens": { "type": "integer" } } }
        }
      },
      "ModelList": {
        "type": "object",
        "properties": {
          "data": { "type": "array", "items": { "type": "object", "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "object": { "type": "string", "default": "model" } } } }
        }
      }
    },
    "securitySchemes": {
      "bearer": { "type": "http", "scheme": "bearer" },
      "clientId": { "type": "apiKey", "in": "header", "name": "X-Client-Id" },
      "clientToken": { "type": "apiKey", "in": "header", "name": "X-Client-Token" }
    }
  }
}
